# Editor defaults for this repo. Kept short: the only rules here are the ones
# that would otherwise cause noisy whitespace-only diffs between contributors.
#
# LF everywhere, including on Windows. The tool parses Blutter's disassembly
# and the test fixtures embed that output verbatim, so a checkout that flips
# line endings changes what the parser tests are testing.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown; do not eat them.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
